# ErrataBench live API transport
# - openrouter: default, uses OpenRouter's /chat/completions API
# - openai-compatible: any endpoint that exposes an OpenAI-compatible /chat/completions API
ERRATA_BENCH_API_PROVIDER=openrouter

# Optional endpoint label stored in run/results artifacts so results from different
# backends do not get mixed together. Defaults to "openrouter" or the compatible
# endpoint host/path.
ERRATA_BENCH_API_ENDPOINT_LABEL=

# Required for live runs.
ERRATA_BENCH_API_KEY=

# Optional. Required for ERRATA_BENCH_API_PROVIDER=openai-compatible.
# For OpenRouter, the default is https://openrouter.ai/api/v1.
ERRATA_BENCH_API_BASE_URL=

# If your compatible endpoint rejects the OpenRouter-style `reasoning` object,
# set this to `omit`. Default is `passthrough`.
ERRATA_BENCH_API_REASONING_MODE=passthrough

# Default live model / judge model for eval, bench, and score.
ERRATA_BENCH_DEFAULT_MODEL=
ERRATA_BENCH_DEFAULT_JUDGE_MODEL=

# Corruptor-specific defaults still override the benchmark-wide defaults when set.
ERRATA_BENCH_DEFAULT_CORRUPTION_MODEL=
ERRATA_BENCH_DEFAULT_CORRUPTION_REVIEW_MODEL=

# Default persistent benchmark results id.
ERRATA_BENCH_DEFAULT_RESULTS_ID=official-v1

# Optional model pricing override file for non-OpenRouter endpoints or custom prices.
# Format:
# {
#   "my-org/my-model": {
#     "inputUsdPerMillionTokens": 2.5,
#     "outputUsdPerMillionTokens": 10
#   }
# }
ERRATA_BENCH_PRICING_FILE=
